{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/i686-w64-mingw32-g++",
            "args": [
                "-static",
                "-shared",
                "-g",
                "-o",
                "${workspaceFolder}/openrayne.dll",
